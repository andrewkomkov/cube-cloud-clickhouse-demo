<clickhouse>
    <!-- Admin user "default": only from inside the container (seeding, maintenance). -->
    <users>
        <default>
            <networks replace="replace">
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
        </default>

        <!-- Read-only user for Cube Cloud and self-hosted Cube. -->
        <cube>
            <password from_env="CH_CUBE_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>cube</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT, SHOW ON demo.*</query>
            </grants>
        </cube>
    </users>

    <profiles>
        <cube>
            <!-- readonly=2: no writes, but the driver may still set session settings -->
            <readonly>2</readonly>
            <max_execution_time>180</max_execution_time>
            <max_memory_usage>6000000000</max_memory_usage>
            <max_threads>6</max_threads>
            <!-- Cube Cloud reads pre-aggregation partitions over the internet and
                 consumes the stream slower than ClickHouse writes it. The default 30 s
                 send timeout breaks these builds. -->
            <send_timeout>600</send_timeout>
            <http_send_timeout>600</http_send_timeout>
            <receive_timeout>600</receive_timeout>
            <http_receive_timeout>600</http_receive_timeout>
        </cube>
    </profiles>
</clickhouse>
